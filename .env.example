# Copy to .env to override config/settings.json without editing it.
# All values are optional.

# LM Studio OpenAI-compatible endpoint
MIKUOS_LMSTUDIO_URL=http://127.0.0.1:1234/v1
# "auto" = use the model already loaded in LM Studio (prefers ids containing "miku")
MIKUOS_MODEL=auto
# SQLite database path (relative to the project folder or absolute)
MIKUOS_DB=data/mikuos.db
# Persona / system prompt file (kept as is, editable)
MIKUOS_SYSTEM_PROMPT=miku_data/miku_persona_system_v4.txt
# Local API port (always bound to 127.0.0.1)
MIKUOS_PORT=8765
# chatty | normal | quiet | dnd
MIKUOS_INITIATIVE=normal
# DEBUG | INFO | WARNING
MIKUOS_LOG_LEVEL=INFO
